{
  "name": "kubepilot",
  "version": "1.3.0",
  "description": "A native desktop UI for browsing and operating Kubernetes clusters",
  "author": {
    "name": "Kubepilot Program",
    "email": "kubepilot.dashboard@gmail.com"
  },
  "license": "MIT",
  "desktopName": "kubepilot",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm run dev",
    "version:sync": "node scripts/sync-version.mjs",
    "fetch:trivy": "node scripts/fetch-trivy.mjs",
    "postinstall": "node scripts/fix-pty-helper.mjs",
    "test": "node --test --experimental-test-coverage \"test/**/*.test.mjs\"",
    "test:client": "npm test --prefix client --if-present",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "build": "npm run version:sync && cd client && npm run build",
    "start": "node server.js",
    "app": "electron .",
    "app:pack": "npm run build && electron-builder --dir --mac",
    "app:dist": "npm run build && electron-builder --mac",
    "dist": "npm run build && electron-builder --publish never",
    "mcp": "node mcp-stdio.js",
    "dist:bundled-trivy": "npm run fetch:trivy && npm run build && electron-builder --publish never -c.extraResources.from=bin -c.extraResources.to=bin -c.extraResources.filter=trivy*"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-eks": "^3.1127.0",
    "@aws-sdk/client-sso": "^3.1127.0",
    "@aws-sdk/client-sso-oidc": "^3.1127.0",
    "@aws-sdk/client-sts": "^3.1127.0",
    "@aws-sdk/credential-providers": "^3.1127.0",
    "@aws-sdk/signature-v4": "^3.370.0",
    "@kubernetes/client-node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/shared-ini-file-loader": "^4.7.2",
    "@smithy/signature-v4": "^5.7.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "concurrently": "^8.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8"
  },
  "build": {
    "appId": "com.kubepilot.desktop",
    "productName": "KubePilot",
    "asar": false,
    "npmRebuild": false,
    "afterPack": "electron/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "*.js",
      "lib/**/*",
      "VERSION",
      "package.json",
      "client/dist/**/*",
      "!**/*.d.ts",
      "!**/*.map",
      "!**/*.md",
      "!**/*.markdown",
      "!**/{test,tests,__tests__,__mocks__,example,examples,docs,doc,.github,.vscode,.idea}/**",
      "!eslint.config.js",
      "!**/node_modules/@types/**",
      "!**/node_modules/**/*.ts",
      "!**/node_modules/**/{CHANGELOG*,changelog*,HISTORY*,*.tsbuildinfo,tsconfig*.json,.eslintrc*,.prettierrc*,.travis.yml,.npmignore,.editorconfig}"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "${productName}-macos.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "format": "ULFO"
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "A desktop UI for browsing and operating Kubernetes clusters",
      "description": "KubePilot is a native desktop app for browsing and operating any Kubernetes cluster from your local kubeconfig — live dashboards, logs, an in-pod shell, topology, Helm, Argo CD, a Security Center and one-click EKS/AKS onboarding.",
      "maintainer": "Kubepilot Program <kubepilot.dashboard@gmail.com>",
      "vendor": "Kubepilot Program",
      "syncDesktopName": true,
      "artifactName": "${productName}-linux.${ext}",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-windows.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "shortcutName": "KubePilot",
      "uninstallDisplayName": "KubePilot",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "deb": {
      "fpm": [
        "--replaces",
        "k8dashboard",
        "--replaces",
        "k8s-manager-ui",
        "--replaces",
        "k8sight",
        "--conflicts",
        "k8dashboard",
        "--conflicts",
        "k8s-manager-ui",
        "--conflicts",
        "k8sight"
      ]
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
