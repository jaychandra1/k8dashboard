<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for a Developer-ID-signed, hardened-runtime build of k8sight.
  Referenced by package.json (build.mac.entitlements / entitlementsInherit) so
  enabling notarization is a config flip: set mac.identity + hardenedRuntime.
  Today the app is ad-hoc signed without the hardened runtime, so this file is
  inert — see electron/after-pack.cjs.

  - allow-jit / allow-unsigned-executable-memory: required by V8 (Electron).
  - disable-library-validation: the node-pty native addon and Electron
    Framework are not signed with the app's Team ID.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
